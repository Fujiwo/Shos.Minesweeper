@page "/"
@inject TimeProvider TimeProvider

<PageTitle>マインスイーパー</PageTitle>

<h1 class="visually-hidden">マインスイーパー</h1>

<div class="game">
    <BoardArea Difficulty="game.Difficulty" Context="placement">
        <BoardView Game="game" Placement="placement" OnOpen="OpenCell" OnToggleFlag="ToggleFlag" />
    </BoardArea>
</div>

@code {
    Game game = default!;

    protected override void OnInitialized() => game = new Game(Difficulty.Beginner, TimeProvider);

    void OpenCell(CellPosition position) => game.Open(position);

    void ToggleFlag(CellPosition position) => game.ToggleFlag(position);
}
