@implements IAsyncDisposable
@inject BrowserFeatures Browser

@* 盤面の領域。大きさを測って GamePage に知らせる。置き方は GamePage が求める（アーキテクチャー設計書 8.5） *@
<div class="board-area" @ref="area">
    @ChildContent
</div>

@code {
    /// <summary>盤面。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>領域の大きさが分かったとき、変わったとき。</summary>
    [Parameter] public EventCallback<BoardAreaSize> OnResized { get; set; }

    ElementReference area;
    IAsyncDisposable? sizeObservation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            sizeObservation = await Browser.ObserveSizeAsync(area, NotifyResizedAsync);
    }

    // JavaScript から呼ばれるので、コンポーネントの処理の流れに戻してから知らせる
    Task NotifyResizedAsync(double width, double height)
        => InvokeAsync(() => OnResized.InvokeAsync(new BoardAreaSize(width, height)));

    public async ValueTask DisposeAsync()
    {
        if (sizeObservation is not null)
            await sizeObservation.DisposeAsync();
    }
}
