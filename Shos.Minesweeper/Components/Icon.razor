@* アイコンは 24×24 の座標で描き、置く場所の CSS で大きさと色を決める（UI デザイン 4.4） *@
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-kind="@Kind">
    @switch (Kind)
    {
        case IconKind.Flag:
            <FlagShape />
            break;
        case IconKind.WrongFlag:
            <FlagShape />
            <path class="cross" d="M5 5 L19 19 M19 5 L5 19" />
            break;
        case IconKind.Mine:
            <MineShape />
            break;
        case IconKind.ExplodedMine:
            <polygon class="explosion" points="23,12 18.28,13.68 21.53,17.5 16.6,16.6 17.5,21.53 13.68,18.28 12,23 10.32,18.28 6.5,21.53 7.4,16.6 2.47,17.5 5.72,13.68 1,12 5.72,10.32 2.47,6.5 7.4,7.4 6.5,2.47 10.32,5.72 12,1 13.68,5.72 17.5,2.47 16.6,7.4 21.53,6.5 18.28,10.32" />
            <g class="exploded-mine"><MineShape /></g>
            break;
        case IconKind.Shovel:
            <line class="shovel-grip" x1="9" y1="3" x2="15" y2="3" />
            <line class="shovel-handle" x1="12" y1="3" x2="12" y2="13" />
            <path class="shovel-blade" d="M7 12 H17 V15.5 A5 5 0 0 1 7 15.5 Z" />
            break;
        case IconKind.FaceNormal:
            <circle class="face" cx="12" cy="12" r="10" />
            <circle class="face-feature" cx="8.8" cy="10" r="1.3" />
            <circle class="face-feature" cx="15.2" cy="10" r="1.3" />
            <path class="face-line" d="M8 14.2 Q12 17.8 16 14.2" />
            break;
        case IconKind.FaceSurprised:
            <circle class="face" cx="12" cy="12" r="10" />
            <circle class="face-feature" cx="8.8" cy="10" r="1.3" />
            <circle class="face-feature" cx="15.2" cy="10" r="1.3" />
            <circle class="face-feature" cx="12" cy="15.6" r="2.3" />
            break;
        case IconKind.FaceWon:
            <circle class="face" cx="12" cy="12" r="10" />
            <path class="face-feature" d="M5.8 8.6 H11 V10.4 A2.4 2.4 0 0 1 8.6 12.8 H8.2 A2.4 2.4 0 0 1 5.8 10.4 Z" />
            <path class="face-feature" d="M13 8.6 H18.2 V10.4 A2.4 2.4 0 0 1 15.8 12.8 H15.4 A2.4 2.4 0 0 1 13 10.4 Z" />
            <line class="face-line" x1="11" y1="9.3" x2="13" y2="9.3" />
            <path class="face-line" d="M8 15 Q12 18.4 16 15" />
            break;
        case IconKind.FaceLost:
            <circle class="face" cx="12" cy="12" r="10" />
            <path class="face-line" d="M7.4 8.4 L10.2 11.2 M10.2 8.4 L7.4 11.2 M13.8 8.4 L16.6 11.2 M16.6 8.4 L13.8 11.2" />
            <path class="face-line" d="M8.4 16.6 Q12 13.6 15.6 16.6" />
            break;
        case IconKind.Clock:
            <circle class="outline" cx="12" cy="12" r="9" />
            <path class="outline" d="M12 7 V12 L15.5 14" />
            break;
        case IconKind.Chevron:
            <path class="outline" d="M7 10 L12 15 L17 10" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public IconKind Kind { get; set; }
}
