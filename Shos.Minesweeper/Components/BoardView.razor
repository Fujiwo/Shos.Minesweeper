@implements IDisposable
@using System.Globalization
@inject TimeProvider TimeProvider
@inject BrowserFeatures Browser

<div class="board @(IsFlagMode ? "flag-mode" : "")" role="grid" aria-label="盤面、@Placement.RowCount 行 @Placement.ColumnCount 列"
     style="--cell-size: @(Placement.CellSize)px; --frame-width: @(BoardPlacement.FrameWidth)px; --column-count: @Placement.ColumnCount"
     tabindex="0" aria-activedescendant="@CellIdOf(cursor.Position)" @ref="board" @onkeydown="HandleKeyDownAsync"
     @onpointermove="HandlePointerMoveAsync" @onpointerup="HandlePointerUpAsync"
     @onpointercancel="HandlePointerCancelAsync" @onpointerleave="HandlePointerCancelAsync"
     @oncontextmenu:preventDefault="true">
    @{
        var pressedCells = PressedCells();
    }
    @for (var row = 0; row < Placement.RowCount; row++)
    {
        <div class="board-row" role="row">
            @for (var column = 0; column < Placement.ColumnCount; column++)
            {
                var displayPosition = new DisplayPosition(row, column);
                var position = Placement.ToBoard(displayPosition);
                var appearance = Game.AppearanceOf(position);
                var adjacentMineCount = Game.Board.CellAt(position).AdjacentMineCount;
                CellAnimation? animation = animations.TryGetValue(position, out var found) ? found : null;
                <div id="@CellIdOf(position)" role="gridcell"
                     class="@CellClassOf(appearance, adjacentMineCount, animation, isPressed: pressedCells.Contains(position), isSelected: position == cursor.Position)"
                     style="@DelayStyleOf(animation)"
                     aria-label="@CellPresentation.AccessibleNameOf(displayPosition, appearance, adjacentMineCount)"
                     @onpointerdown="pointer => HandlePointerDownAsync(position, pointer)">
                    @if (CellPresentation.IconOf(appearance) is IconKind icon)
                    {
                        <Icon Kind="icon" />
                    }
                    else
                    {
                        @CellPresentation.NumberTextOf(appearance, adjacentMineCount)
                    }
                </div>
            }
        </div>
    }
</div>

@if (ring is { } shownRing)
{
    <LongPressRing CenterX="shownRing.CenterX" CenterY="shownRing.CenterY" CellSize="Placement.CellSize" Action="shownRing.Action" />
}

@code {
    const int LongPressVibrationMilliseconds = 30;   // UI デザイン 5.2
    static readonly IReadOnlyDictionary<CellPosition, CellAnimation> NoAnimations = new Dictionary<CellPosition, CellAnimation>();

    [Parameter, EditorRequired] public Game Game { get; set; } = default!;
    [Parameter, EditorRequired] public BoardPlacement Placement { get; set; } = default!;
    [Parameter] public bool IsFlagMode { get; set; }

    /// <summary>直前の操作。演出するマスを決める。新しいゲームでは null。</summary>
    [Parameter] public MoveResult? LastMove { get; set; }

    [Parameter] public EventCallback<CellPosition> OnOpen { get; set; }
    [Parameter] public EventCallback<CellPosition> OnToggleFlag { get; set; }
    [Parameter] public EventCallback<bool> OnPressingChanged { get; set; }

    readonly record struct Ring(double CenterX, double CenterY, CellAction Action);

    PressGesture gesture = default!;
    BoardCursor cursor = new();
    ElementReference board;
    CellPosition? pressedPosition;
    Ring? ring;
    bool isPressing;
    Game? shownGame;
    MoveResult? animatedMove;
    IReadOnlyDictionary<CellPosition, CellAnimation> animations = NoAnimations;
    bool shouldRender = true;

    protected override void OnInitialized()
        => gesture = new PressGesture(TimeProvider, OnPressRecognized);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Game, shownGame))
            StartShowing(Game);
        // 直前の操作が変わったときだけ求め直す。押下中の表示などで描き直しても、演出のクラスと変数が変わらず、
        // アニメーションが最初からやり直さずに続くようにするため（アーキテクチャー設計書 7.3、8.6）
        if (LastMove != animatedMove) {
            animatedMove = LastMove;
            animations = LastMove is { } move ? BoardAnimation.Of(move, Game) : NoAnimations;
        }
        shouldRender = true;
    }

    // pointermove のように表示を変えないイベントでは描き直さない（アーキテクチャー設計書 7.3）
    protected override bool ShouldRender() => shouldRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        shouldRender = false;
        if (firstRender)
            await Browser.SuppressKeyScrollingAsync(board);
    }

    // キーボードの操作（仕様書 4.5）。旗モードはキーボードの操作に影響しない
    async Task HandleKeyDownAsync(KeyboardEventArgs key)
    {
        if (KeyboardMapping.DirectionFor(key.Key) is { } direction) {
            // 勝敗が決まった後も動かせる。敗北した盤面をスクリーンリーダーで確かめられるようにするため
            cursor.Move(direction, Placement);
            shouldRender = true;
            return;
        }
        if (Game.IsOver)
            return;
        await RequestAsync(KeyboardMapping.ActionFor(key.Key), cursor.Position);
    }

    async Task HandlePointerDownAsync(CellPosition position, PointerEventArgs pointer)
    {
        // 勝敗が決まった後は、押下中の表示も長押しの円も出さない（UI デザイン 5.1）
        if (Game.IsOver)
            return;
        pressedPosition = position;
        gesture.Down(InputOf(pointer));
        if (gesture.IsWaitingForLongPress)
            ShowRingIfLongPressActs(position, pointer);
        await ReportPressingAsync();
    }

    async Task HandlePointerMoveAsync(PointerEventArgs pointer)
    {
        gesture.Move(InputOf(pointer));
        await UpdateFromGestureAsync();
    }

    async Task HandlePointerUpAsync(PointerEventArgs pointer)
    {
        gesture.Up(InputOf(pointer));
        await UpdateFromGestureAsync();
    }

    // 盤面の外に出たら（pointerleave）取り消す。押したまま外で離すと pointerup が届かないため（アーキテクチャー設計書 8.1）
    async Task HandlePointerCancelAsync(PointerEventArgs pointer)
    {
        gesture.Cancel(InputOf(pointer));
        await UpdateFromGestureAsync();
    }

    // 長押しはタイマーから呼ばれるので、描画の流れに戻してから扱う。例外は Blazor のエラーの表示に渡す
    void OnPressRecognized(PressKind press)
        => _ = InvokeAsync(async () => {
            try {
                await HandlePressAsync(press);
                // タイマーから届いた長押しは、Blazor のイベントではないので、描き直しを自分で求める
                StateHasChanged();
            } catch (Exception exception) {
                await DispatchExceptionAsync(exception);
            }
        });

    async Task HandlePressAsync(PressKind press)
    {
        HideRing();
        await ReportPressingAsync();
        if (pressedPosition is not { } position || Game.IsOver)
            return;

        var action = PressMapping.ActionFor(press, IsFlagMode, Game.Board.CellAt(position));
        if (press == PressKind.LongPress && action != CellAction.None)
            await Browser.VibrateAsync(LongPressVibrationMilliseconds);
        await RequestAsync(action, position);
    }

    Task RequestAsync(CellAction action, CellPosition position)
        => action switch {
            CellAction.Open       => OnOpen.InvokeAsync(position),
            CellAction.ToggleFlag => OnToggleFlag.InvokeAsync(position),
            _                     => Task.CompletedTask
        };

    // 長押しで何も起きないマスでは、円を出さない（UI デザイン 5.2）
    void ShowRingIfLongPressActs(CellPosition position, PointerEventArgs pointer)
    {
        var action = PressMapping.ActionFor(PressKind.LongPress, IsFlagMode, Game.Board.CellAt(position));
        if (action == CellAction.None)
            return;
        // ClientX − OffsetX が、押したマスの左上の画面上の位置になる（アーキテクチャー設計書 9.2）
        var halfCell = Placement.CellSize / 2.0;
        ring = new Ring(pointer.ClientX - pointer.OffsetX + halfCell, pointer.ClientY - pointer.OffsetY + halfCell, action);
        shouldRender = true;
    }

    void HideRing()
    {
        if (ring is null)
            return;
        ring = null;
        shouldRender = true;
    }

    // 押し方の判定の状態に合わせて、長押しの円と押下中の表示を更新する
    async Task UpdateFromGestureAsync()
    {
        if (!gesture.IsWaitingForLongPress)
            HideRing();
        await ReportPressingAsync();
    }

    async Task ReportPressingAsync()
    {
        if (isPressing == gesture.IsPressing)
            return;
        isPressing = gesture.IsPressing;
        shouldRender = true;
        await OnPressingChanged.InvokeAsync(isPressing);
    }

    // 押下中の表示の範囲。未開放ならそのマス、開いた数字のマスならコードで開く範囲（UI デザイン 5.1）
    IReadOnlySet<CellPosition> PressedCells()
    {
        if (!isPressing || pressedPosition is not { } position)
            return new HashSet<CellPosition>();
        return Game.Board.CellAt(position).State == CellState.Closed
               ? new HashSet<CellPosition> { position }
               : Game.Board.ChordTargetsOf(position).ToHashSet();
    }

    // 別のゲームになったら、前のゲームでの押下を捨てる
    void StartShowing(Game game)
    {
        shownGame = game;
        cursor = new BoardCursor();
        gesture.Reset();
        pressedPosition = null;
        ring = null;
        isPressing = false;
    }

    // 付けるクラスを 1 行に 1 つ並べ、付けないもの（null）を除いてつなぐ
    static string CellClassOf(CellAppearance appearance, int adjacentMineCount, CellAnimation? animation, bool isPressed, bool isSelected)
        => string.Join(' ', new[] {
               "cell",
               CellPresentation.CssClassOf(appearance, adjacentMineCount),
               animation is { } shown ? CellPresentation.CssClassOf(shown.Kind) : null,
               isPressed ? "pressed" : null,
               isSelected ? "selected" : null,
           }.OfType<string>());

    // 遅れの比は CSS が演出ごとの最大の遅れに掛ける。端末の言語によらず小数点が「.」になるように、インバリアント カルチャーで書く
    static string? DelayStyleOf(CellAnimation? animation)
        => animation is { } shown ? string.Create(CultureInfo.InvariantCulture, $"--delay-ratio: {shown.DelayRatio}") : null;

    static string CellIdOf(CellPosition position) => $"cell-{position.Row}-{position.Column}";

    static PointerInput InputOf(PointerEventArgs pointer)
        => new(pointer.PointerId, pointer.PointerType, pointer.Button, pointer.ClientX, pointer.ClientY);

    public void Dispose() => gesture.Dispose();
}
