@*
    勝利カード（UI デザイン 2.4、10.5）。モードレスのダイアログ。
    盤面の領域いっぱいの置き場に、盤面の下端までの高さの詰め物とカードを縦に並べる。盤面の下に余白があればカードは盤面の下に来て、
    なければ詰め物が縮んで、カードは領域の下端に寄る。カードの高さを C# で知らずに済む（アーキテクチャー設計書 9.2）
*@
<div class="win-card-area">
    <div class="spacer"></div>
    <div class="win-card" role="dialog" aria-labelledby="win-card-title" @onkeydown="HandleKeyDownAsync">
        <div class="heading">
            <span class="face"><Icon Kind="IconKind.FaceWon" /></span>
            <h2 id="win-card-title" tabindex="-1" @ref="heading">@WinCardTexts.Title</h2>
        </div>
        <p class="time">@WinCardTexts.TimeOf(Seconds)</p>
        @* カスタムは記録しないので、ベストタイムの行を出さない（文が null） *@
        @if (WinCardTexts.BestTimeOf(BestTime) is { } bestTimeText)
        {
            if (BestTime.IsNewBest)
            {
                <p class="best-time new"><span class="star"><Icon Kind="IconKind.Star" /></span>@bestTimeText</p>
            }
            else
            {
                <p class="best-time">@bestTimeText</p>
            }
        }
        <div class="actions">
            <button type="button" class="play-again" @onclick="OnPlayAgain">@WinCardTexts.PlayAgain</button>
            <button type="button" class="close" @onclick="OnClose">@WinCardTexts.Close</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int Seconds { get; set; }
    [Parameter, EditorRequired] public BestTimeResult BestTime { get; set; }

    /// <summary>同じ難易度で新しいゲームを始める（リセット ボタンと同じ）。</summary>
    [Parameter] public EventCallback OnPlayAgain { get; set; }

    /// <summary>カードを閉じて、勝った盤面を見られるようにする。</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    ElementReference heading;

    // フォーカスはボタンではなく見出しに移す。最後のマスを開くために押した Space や Enter を
    // 続けて押したときに、意図せず新しいゲームが始まらないようにするため（UI デザイン 2.4）
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await heading.FocusAsync();
    }

    async Task HandleKeyDownAsync(KeyboardEventArgs key)
    {
        if (key.Key == "Escape")
            await OnClose.InvokeAsync();
    }
}
