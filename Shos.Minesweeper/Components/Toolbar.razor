@* ツールバー。左（横バーでは上）から、難易度、残り地雷数、リセット、経過時間、旗モード、効果音の順に並べる（UI デザイン 2.1、10.3） *@
<div class="toolbar">
    <button type="button" class="difficulty" aria-label="難易度、@DifficultyName" title="難易度を変える" @ref="difficultyButton" @onclick="OnDifficultyClick">
        <span class="difficulty-name">@DifficultyName</span>
        <span class="chevron"><Icon Kind="IconKind.Chevron" /></span>
    </button>
    <ToolbarCounter Class="remaining-mines" Icon="IconKind.Mine" Value="Game.RemainingMineCount"
                    AccessibleName="@($"残り地雷 {Game.RemainingMineCount}")" />
    <button type="button" class="reset" aria-label="新しいゲーム" title="新しいゲーム" @ref="resetButton" @onclick="OnResetClick">
        <span class="face-icon"><Icon Kind="Face" /></span>
    </button>
    <ElapsedTime Game="Game" />
    <button type="button" class="flag-mode @(IsFlagMode ? "on" : "")" aria-label="旗モード" aria-pressed="@(IsFlagMode ? "true" : "false")"
            title="@(IsFlagMode ? "旗モード（オン）" : "旗モード（オフ）")" @onclick="OnFlagModeClick">
        <span class="flag-icon"><Icon Kind="IconKind.Flag" /></span>
        <span class="flag-mode-label">旗モード</span>
    </button>
    @* 効果音のオンとオフは、アイコンの形だけで示し、背景は塗らない（UI デザイン 10.3、10.8 の決定 9） *@
    <button type="button" class="sound" aria-label="効果音" aria-pressed="@(IsSoundEnabled ? "true" : "false")"
            title="@(IsSoundEnabled ? "効果音（オン）" : "効果音（オフ）")" @onclick="OnSoundClick">
        <span class="sound-icon"><Icon Kind="@(IsSoundEnabled ? IconKind.SoundOn : IconKind.SoundOff)" /></span>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public Game Game { get; set; } = default!;
    [Parameter] public bool IsPressing { get; set; }
    [Parameter] public bool IsFlagMode { get; set; }
    [Parameter] public bool IsSoundEnabled { get; set; }

    [Parameter] public EventCallback OnDifficultyClick { get; set; }
    [Parameter] public EventCallback OnResetClick { get; set; }
    [Parameter] public EventCallback OnFlagModeClick { get; set; }
    [Parameter] public EventCallback OnSoundClick { get; set; }

    ElementReference difficultyButton;
    ElementReference resetButton;

    /// <summary>難易度ダイアログを閉じたときに、フォーカスを戻す（UI デザイン 6.3）。</summary>
    public ValueTask FocusDifficultyButtonAsync() => difficultyButton.FocusAsync();

    /// <summary>勝利カードを閉じたときに、フォーカスを移す（UI デザイン 2.4）。</summary>
    public ValueTask FocusResetButtonAsync() => resetButton.FocusAsync();

    string DifficultyName => DifficultyNames.Of(Game.Difficulty.Kind);

    // 顔でゲームの状態を示す（UI デザイン 4.4）。勝敗が決まった後は、押していても驚かない
    IconKind Face
        => Game.Status switch {
            GameStatus.Won  => IconKind.FaceWon,
            GameStatus.Lost => IconKind.FaceLost,
            _               => IsPressing ? IconKind.FaceSurprised : IconKind.FaceNormal
        };
}
