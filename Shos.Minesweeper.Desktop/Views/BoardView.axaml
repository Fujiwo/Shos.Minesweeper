<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Shos.Minesweeper.Desktop.Views"
             xmlns:vm="using:Shos.Minesweeper.Desktop.ViewModels"
             x:Class="Shos.Minesweeper.Desktop.Views.BoardView"
             x:DataType="vm:BoardViewModel">
    <!-- 盤面。マスを 1 つずつフォーカスを受けられる部品にし、Tab の移動先は盤面の 1 つにする（アーキテクチャー設計書 7.4） -->
    <Border Classes="board" BorderThickness="{x:Static v:BoardView.FrameThickness}"
            AutomationProperties.Name="{Binding AccessibleName}">
        <ItemsControl x:Name="CellsControl" ItemsSource="{Binding Cells}"
                      Width="{Binding CellsWidth}" Height="{Binding CellsHeight}"
                      KeyboardNavigation.TabNavigation="Once">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{ReflectionBinding ColumnCount}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CellViewModel">
                    <v:CellView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
