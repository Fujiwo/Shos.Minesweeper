<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Shos.Minesweeper.Desktop.Views"
             xmlns:vm="using:Shos.Minesweeper.Desktop.ViewModels"
             x:Class="Shos.Minesweeper.Desktop.Views.CellView"
             x:DataType="vm:CellViewModel"
             Classes.pressed="{Binding IsPressed}"
             AutomationProperties.Name="{Binding AccessibleName}">
    <!-- 1 つのマス。見せ方（未開放、旗、数字、地雷など）のクラスと数字とアイコンは、code-behind が見せ方から決める -->
    <Panel>
        <Border Classes="tile">
            <Panel>
                <!-- 未開放のタイルの覆い。開く演出と地雷が現れる演出の間だけ出し、遅れの間は未開放に見せる（Web 版のクラス設計書 12.11 の決定 10） -->
                <Border x:Name="Cover" Classes="cover" />
                <TextBlock x:Name="NumberText" Classes="number" />
                <v:IconView x:Name="Icon" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
        </Border>
        <Border Classes="focus-frame">
            <Border />
        </Border>
    </Panel>
</UserControl>
