<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Shos.Minesweeper.Desktop.Views"
             xmlns:vm="using:Shos.Minesweeper.Desktop.ViewModels"
             xmlns:p="using:Shos.Minesweeper.Presentation"
             x:Class="Shos.Minesweeper.Desktop.Views.ToolbarView"
             x:DataType="vm:GameViewModel">
    <!--
      ツールバー。左から、難易度、残り地雷数、リセット、経過時間、効果音の順に、均等の間隔で並べる（UI デザイン 2.4）
    -->
    <Border Classes="toolbar">
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto">
            <Button x:Name="DifficultyButton" Grid.Column="0" Classes="difficulty" Command="{Binding OpenDifficultyDialog}"
                    AutomationProperties.Name="{Binding DifficultyButtonName}" ToolTip.Tip="{x:Static p:ToolbarTexts.DifficultyToolTip}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding DifficultyName}" VerticalAlignment="Center" />
                    <v:IconView Kind="Chevron" Width="16" Height="16" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Grid.Column="2" Classes="counter" AutomationProperties.Name="{Binding RemainingMinesName}">
                <DockPanel>
                    <v:IconView DockPanel.Dock="Left" Kind="Mine" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RemainingMineCount}" />
                </DockPanel>
            </Border>
            <Button x:Name="ResetButton" Grid.Column="4" Classes="reset" Command="{Binding NewGame}"
                    AutomationProperties.Name="{x:Static p:ToolbarTexts.NewGame}" ToolTip.Tip="{x:Static p:ToolbarTexts.NewGame}">
                <v:IconView Kind="{Binding Face, Converter={x:Static v:ViewConverters.FaceIcon}}" Width="28" Height="28" />
            </Button>
            <Border Grid.Column="6" Classes="counter" AutomationProperties.Name="{Binding ElapsedTimeName}">
                <DockPanel>
                    <v:IconView DockPanel.Dock="Left" Kind="Clock" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ElapsedSeconds}" />
                </DockPanel>
            </Border>
            <!-- オンかオフかを、トグル ボタンの状態としてナレーターに伝える（UI デザイン 2.11）。切り替えるのはビューモデルで、状態はそこから受ける -->
            <ToggleButton Grid.Column="8" Classes="sound" IsChecked="{Binding IsSoundEnabled, Mode=OneWay}" Command="{Binding ToggleSound}"
                          AutomationProperties.Name="{x:Static p:ToolbarTexts.SoundEffects}" ToolTip.Tip="{Binding SoundEffectsToolTip}">
                <v:IconView Kind="{Binding IsSoundEnabled, Converter={x:Static v:ViewConverters.SoundIcon}}" Width="24" Height="24" />
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
