<Project Sdk="Microsoft.NET.Sdk">

  <!-- コンソール版（docs/desktop-console/04-architecture.md の 8 章）。名前を Console にしないのは、名前空間が System.Console を隠すため -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LibraryImport（Windows のコンソールのモードを変える P/Invoke）が生成するコードのため -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shos.Minesweeper.GameLogic\Shos.Minesweeper.GameLogic.csproj" />
    <ProjectReference Include="..\Shos.Minesweeper.Presentation\Shos.Minesweeper.Presentation.csproj" />
  </ItemGroup>

</Project>
